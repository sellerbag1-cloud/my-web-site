.symptom-card-desc { font-size: 14px; line-height: 1.7; color: var(--color-text-muted); }
.compare-table {
  width: 100%; border-collapse: collapse; margin: 32px 0;
  background: var(--color-bg-section); border: 1px solid var(--color-border);
}
.compare-table th, .compare-table td {
  padding: 14px 20px; text-align: left; font-size: 14px;
  border-bottom: 1px solid var(--color-border); vertical-align: top;
}
.compare-table th {
  background: var(--color-primary); color: #fff;
