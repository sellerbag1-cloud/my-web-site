}
.highlight-box-content { position: relative; z-index: 1; padding-left: 40px; }
.highlight-box p {
  color: #fff; font-family: var(--font-serif); font-size: 19px;
  line-height: 1.7; margin: 0; max-width: none;
}
.highlight-box-caption {
  font-size: 12px; letter-spacing: 0.2em; color: rgba(255,255,255,.6);
  text-transform: uppercase; margin-top: 16px;
}
.warning-box {
  background: #fef4f4; border-left: 4px solid var(--color-accent);
  padding: 24px 28px; margin: 32px 0;
}
.warning-box-title {
  font-weight: 600; color: var(--color-accent); margin-bottom: 8px;
  font-size: 15px; letter-spacing: 0.02em;
}
.warning-box-desc { font-size: 14px; color: var(--color-text); line-height: 1.75; }
.info-box {
  background: #f0f4fa; border-left: 4px solid var(--color-primary);
  padding: 24px 28px; margin: 32px 0;
}
.info-box-title {
  font-weight: 600; color: var(--color-primary); margin-bottom: 8px;
  font-size: 15px; letter-spacing: 0.02em;
}
.info-box-desc { font-size: 14px; color: var(--color-text); line-height: 1.75; }
.checklist {
  list-style: none; margin: 24px 0; padding: 24px 32px;
  background: var(--color-bg-section); border: 1px solid var(--color-border);
}
.checklist li {
  padding: 10px 0 10px 32px; position: relative;
  font-size: 15px; line-height: 1.6; border-bottom: 1px solid var(--color-border);
}
.checklist li:last-child { border-bottom: none; }
.checklist li::before {
  content: '□'; position: absolute; left: 0; top: 10px;
  color: var(--color-primary); font-size: 18px; font-weight: 500;
}
.steps {
