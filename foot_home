  gap: 0; margin: 32px 0; border: 1px solid var(--color-border);
}
.step {
  padding: 28px 24px; border-right: 1px solid var(--color-border);
  background: var(--color-bg-section); position: relative;
}
.step:last-child { border-right: none; }
.step-num {
  font-family: var(--font-serif); font-size: 13px; letter-spacing: 0.3em;
  color: var(--color-gold); margin-bottom: 12px;
}
.step-title {
  font-weight: 600; font-size: 15px; color: var(--color-primary); margin-bottom: 8px;
}
.step-desc { font-size: 13px; line-height: 1.6; color: var(--color-text-muted); }
.doctor-card {
  display: grid; grid-template-columns: 1fr 2fr; gap: 40px;
