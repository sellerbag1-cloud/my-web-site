.doctor-credentials { font-family: var(--font-serif); }
.doctor-name {
  font-size: 28px; font-weight: 500; color: var(--color-primary); margin-bottom: 4px;
}
.doctor-role {
  font-size: 14px; color: var(--color-text-muted);
  letter-spacing: 0.05em; margin-bottom: 24px;
}
.doctor-credentials ul {
  list-style: none; font-family: var(--font-sans);
  font-size: 14px; line-height: 1.9; color: var(--color-text);
}
.doctor-credentials li { padding-left: 16px; position: relative; }
.doctor-credentials li::before {
  content: '—'; position: absolute; left: 0; color: var(--color-gold);
}
.cta-section { background: var(--color-primary); padding: 80px 32px; text-align: center; }
.cta-inner { max-width: 800px; margin: 0 auto; color: #fff; }
.cta-eyebrow {
  font-size: 12px; letter-spacing: 0.3em; color: var(--color-gold);
  margin-bottom: 16px; text-transform: uppercase;
}
.cta-title {
  font-family: var(--font-serif); font-size: 36px; font-weight: 400;
  margin-bottom: 16px; line-height: 1.3;
}
.cta-desc {
  font-size: 16px; color: rgba(255,255,255,.85);
  margin-bottom: 36px; line-height: 1.8;
}
.cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.cta-btn-primary {
  display: inline-block; padding: 16px 40px; background: #fff;
  color: var(--color-primary); font-weight: 500; text-decoration: none;
  font-size: 15px; letter-spacing: 0.02em; transition: all .2s;
}
.cta-btn-primary:hover { background: var(--color-gold); color: #fff; }
.cta-btn-secondary {
  display: inline-block; padding: 16px 40px; background: transparent;
  color: #fff; border: 1px solid rgba(255,255,255,.4);
  font-weight: 400; text-decoration: none;
  font-size: 15px; letter-spacing: 0.02em; transition: all .2s;
}
.cta-btn-secondary:hover { background: rgba(255,255,255,.1); border-color: #fff; }
footer { background: #0f1f33; color: rgba(255,255,255,.65); padding: 60px 32px 40px; }
.footer-inner { max-width: 1200px; margin: 0 auto; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 60px; margin-bottom: 40px; }
.footer-brand-name {
  font-family: var(--font-serif); font-size: 22px;
  font-weight: 500; color: #fff; margin-bottom: 12px;
}
.footer-brand-desc {
  font-size: 13px; line-height: 1.8;
  color: rgba(255,255,255,.55); max-width: 400px;
}
.footer-section h4 {
  font-family: var(--font-serif); font-size: 14px; color: #fff;
  margin-bottom: 16px; letter-spacing: 0.05em;
}
.footer-section ul { list-style: none; font-size: 13px; line-height: 2; }
.footer-section a { color: rgba(255,255,255,.65); text-decoration: none; transition: color .2s; }
.footer-section a:hover { color: var(--color-gold); }
.footer-bottom {
