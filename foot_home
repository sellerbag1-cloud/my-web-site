}
.compare-table tbody tr:last-child td { border-bottom: none; }
.compare-table tbody tr:hover { background: var(--color-bg-alt); }
.compare-table .label { font-weight: 500; color: var(--color-primary); width: 28%; }
.highlight-box {
  background: var(--color-primary); color: #fff; padding: 40px;
  margin: 40px 0; position: relative;
}
.highlight-box::before {
